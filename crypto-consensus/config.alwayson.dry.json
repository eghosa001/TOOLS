{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "eth-guarded-persistent-kraken-DRYRUN-ONLY",
  "dry_run": true,
  "dry_run_wallet": 150,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "stake_currency": "USD",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.95,
  "max_open_trades": 1,
  "fiat_display_currency": "USD",
  "cancel_open_orders_on_exit": true,
  "unfilledtimeout": {
    "entry": 5,
    "exit": 5,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "exchange": {
    "name": "krakenfutures",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "ETH/USD:USD"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "order_types": {
    "entry": "market",
    "exit": "market",
    "emergency_exit": "market",
    "force_exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": true,
    "stoploss_on_exchange_interval": 60,
    "stoploss_price_type": "mark"
  },
  "internals": {
    "process_throttle_secs": 10,
    "heartbeat_interval": 60
  },
  "db_url": "sqlite:////freqtrade/runtime/tradesv3.dryrun.sqlite",
  "force_entry_enable": false,
  "ignore_buying_expired_candle_after": 300,
  "initial_state": "running"
}
