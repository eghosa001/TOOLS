; CartoonStudio independent Godot 4 scene viewer and movie-development project.
; Original cast silhouettes are retained across episodes.
config_version=5

[application]
config/name="CartoonStudio — Godot 3D Library"
run/main_scene="res://scenes/studio.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
3d/default_gravity=9.8
